<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Client Dashboard - Rooted Vitality</title>
    <link rel="stylesheet" href="../styles/base.css">
    <link rel="stylesheet" href="../styles/layout.css">
    <link rel="stylesheet" href="../styles/components.css">
    <link rel="stylesheet" href="../styles/pages.css">
    <link rel="stylesheet" href="../styles/dashboard-client.css">
</head>
<body>
    <!-- Header (injected by injections.js) -->
    <div id="rvHeaderContainer"></div>

    <!-- Main Dashboard Container -->
    <main class="dashboard-wrapper">
        <div class="container-narrow">
            <!-- Dashboard Header -->
            <div class="dashboard-header">
                <div class="header-text">
                    <h1>Your Wellness Journey</h1>
                    <p class="subtitle">Manage your account, preferences, and wellness goals</p>
                </div>
            </div>

            <!-- ============================================
                 1. ACCOUNT INFORMATION SECTION
                 ============================================ -->
            <section class="dashboard-section">
                <div class="section-header">
                    <h2>Account Information</h2>
                    <span class="section-note">(All fields editable except email)</span>
                </div>

                <form id="accountForm" class="form-grid">
                    <div class="form-group">
                        <label for="firstName">First Name *</label>
                        <input type="text" id="firstName" name="firstName" required>
                    </div>

                    <div class="form-group">
                        <label for="lastName">Last Name *</label>
                        <input type="text" id="lastName" name="lastName" required>
                    </div>

                    <div class="form-group full-width">
                        <label for="email">Email Address (Read-only)</label>
                        <input type="email" id="email" name="email" readonly disabled>
                        <p class="field-hint">To change your email, contact support</p>
                    </div>

                    <div class="form-group">
                        <label for="phone">Phone Number</label>
                        <input type="tel" id="phone" name="phone">
                    </div>

                    <div class="form-group">
                        <label for="age">Age</label>
                        <input type="number" id="age" name="age" min="18">
                    </div>

                    <div class="form-group">
                        <label for="sex">Sex</label>
                        <select id="sex" name="sex">
                            <option value="">Select...</option>
                            <option value="male">Male</option>
                            <option value="female">Female</option>
                            <option value="other">Other</option>
                            <option value="prefer-not-to-say">Prefer not to say</option>
                        </select>
                    </div>

                    <div class="form-group full-width">
                        <label for="gender">Gender</label>
                        <input type="text" id="gender" name="gender" placeholder="Optional">
                    </div>

                    <div class="form-actions full-width">
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                        <button type="button" id="changePasswordBtn" class="btn btn-secondary">Change Password</button>
                    </div>
                </form>
            </section>

            <!-- ============================================
                 2. MEMBERSHIP MANAGEMENT SECTION
                 ============================================ -->
            <section class="dashboard-section">
                <div class="section-header">
                    <h2>Membership</h2>
                    <span class="section-note">(Placeholder for future feature)</span>
                </div>

                <div class="membership-container">
                    <div class="membership-display">
                        <div class="membership-badge" id="membershipBadge">
                            <span class="badge-label">Current Tier</span>
                            <span class="badge-value" id="currentTier">Free</span>
                        </div>
                        <p class="membership-description">
                            You have access to free wellness resources and practitioner directory browsing.
                        </p>
                    </div>

                    <div class="membership-actions">
                        <button type="button" class="btn btn-secondary" id="upgradeBasicBtn">
                            Upgrade to Basic
                        </button>
                        <button type="button" class="btn btn-secondary" id="upgradePremiumBtn">
                            Upgrade to Premium
                        </button>
                    </div>

                    <p class="future-feature-note">
                        🔮 Future Feature: Tiered membership system with benefits, pricing, and billing management.
                    </p>
                </div>
            </section>

            <!-- ============================================
                 3. CONNECTION PREFERENCES SECTION
                 ============================================ -->
            <section class="dashboard-section">
                <div class="section-header">
                    <h2>Connection Preferences</h2>
                    <span class="section-note">(Placeholder for future feature)</span>
                </div>

                <div class="preference-item">
                    <div class="toggle-container">
                        <label for="openToContact" class="toggle-label">Open to Contact by Practitioners</label>
                        <div class="toggle-switch">
                            <input type="checkbox" id="openToContact" name="openToContact">
                            <span class="toggle-slider"></span>
                        </div>
                    </div>
                    <p class="field-hint">
                        When enabled, practitioners can reach out to connect about services relevant to your wellness goals.
                    </p>
                </div>

                <p class="future-feature-note">
                    🔮 Future Feature: Practitioner outreach system, communication filters, and notification preferences.
                </p>
            </section>

            <!-- ============================================
                 4. WELLNESS PROFILE SECTION
                 ============================================ -->
            <section class="dashboard-section">
                <div class="section-header">
                    <h2>Wellness Profile</h2>
                    <span class="section-note">(Placeholder for future feature)</span>
                </div>

                <form id="wellnessForm" class="form-grid">
                    <div class="form-group full-width">
                        <label for="wellnessGoals">Wellness Goals</label>
                        <textarea id="wellnessGoals" name="wellnessGoals" rows="3" placeholder="Describe your wellness aspirations..."></textarea>
                    </div>

                    <div class="form-group full-width">
                        <label for="healthFocus">Current Health Focus</label>
                        <textarea id="healthFocus" name="healthFocus" rows="3" placeholder="What are you currently working on?"></textarea>
                    </div>

                    <div class="form-group full-width">
                        <label for="healingModalities">Preferred Healing Modalities</label>
                        <select id="healingModalities" name="healingModalities" multiple>
                            <option value="acupuncture">Acupuncture</option>
                            <option value="aromatherapy">Aromatherapy</option>
                            <option value="ayurveda">Ayurveda</option>
                            <option value="chakra-healing">Chakra Healing</option>
                            <option value="coaching">Coaching</option>
                            <option value="energy-work">Energy Work</option>
                            <option value="herbal-medicine">Herbal Medicine</option>
                            <option value="massage">Massage Therapy</option>
                            <option value="meditation">Meditation</option>
                            <option value="nutrition">Nutrition</option>
                            <option value="reiki">Reiki</option>
                            <option value="yoga">Yoga</option>
                            <option value="other">Other</option>
                        </select>
                        <p class="field-hint">Select one or more modalities (hold Ctrl/Cmd to select multiple)</p>
                    </div>

                    <div class="form-group full-width">
                        <label for="locationPreference">Location Preference</label>
                        <select id="locationPreference" name="locationPreference">
                            <option value="">Select...</option>
                            <option value="in-person">In-person</option>
                            <option value="virtual">Virtual</option>
                            <option value="either">Either</option>
                        </select>
                    </div>

                    <div class="form-actions full-width">
                        <button type="submit" class="btn btn-primary">Save Wellness Profile</button>
                    </div>
                </form>

                <p class="future-feature-note">
                    🔮 Future Feature: Profile visibility settings, sharing with practitioners, and wellness tracking analytics.
                </p>
            </section>

            <!-- ============================================
                 5. WELLNESS PROJECTS SECTION
                 ============================================ -->
            <section class="dashboard-section">
                <div class="section-header">
                    <h2>Wellness Projects</h2>
                </div>

                <div class="projects-grid">
                    <a href="../projects/open-projects.html" class="project-card">
                        <div class="card-icon">📋</div>
                        <h3>Active Wellness Projects</h3>
                        <p>View and manage your current wellness initiatives and progress</p>
                        <span class="card-cta">Browse Projects →</span>
                    </a>

                    <a href="../projects/create-project.html" class="project-card">
                        <div class="card-icon">✨</div>
                        <h3>Start a New Wellness Project</h3>
                        <p>Begin a new wellness journey with practitioner guidance</p>
                        <span class="card-cta">Create Project →</span>
                    </a>
                </div>
            </section>

            <!-- ============================================
                 6. DANGER ZONE SECTION
                 ============================================ -->
            <section class="dashboard-section danger-zone">
                <div class="section-header">
                    <h2 style="color: #d32f2f;">Danger Zone</h2>
                </div>

                <div class="danger-content">
                    <div class="danger-message">
                        <p>
                            <strong>⚠️ Warning:</strong> Deleting your account will permanently remove all data, 
                            including your profile, wellness information, and project history. This action cannot be undone.
                        </p>
                    </div>

                    <button type="button" id="deleteAccountBtn" class="btn btn-danger">
                        Delete Account Permanently
                    </button>
                </div>
            </section>

            <!-- Spacing before footer -->
            <div style="height: 3rem;"></div>
        </div>
    </main>

    <!-- Footer (injected by injections.js) -->
    <div id="rvFooterContainer"></div>

    <!-- ============================================
         MODALS
         ============================================ -->

    <!-- Change Password Modal -->
    <div id="changePasswordModal" class="modal-overlay" inert aria-hidden="true">
        <div class="modal-content" role="dialog" aria-labelledby="passwordModalTitle" aria-modal="true">
            <div class="modal-header">
                <h2 id="passwordModalTitle">Change Password</h2>
                <button class="modal-close" aria-label="Close modal">×</button>
            </div>

            <form id="changePasswordForm" class="form-grid">
                <div class="form-group full-width">
                    <label for="currentPassword">Current Password</label>
                    <input type="password" id="currentPassword" name="currentPassword" required>
                </div>

                <div class="form-group full-width">
                    <label for="newPassword">New Password</label>
                    <input type="password" id="newPassword" name="newPassword" required>
                    <p class="field-hint">Minimum 6 characters</p>
                </div>

                <div class="form-group full-width">
                    <label for="confirmPassword">Confirm New Password</label>
                    <input type="password" id="confirmPassword" name="confirmPassword" required>
                </div>

                <div class="form-actions full-width">
                    <button type="button" class="btn btn-secondary modal-cancel">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update Password</button>
                </div>
            </form>

            <p class="modal-note">
                💡 Placeholder: Password change functionality requires backend integration.
            </p>
        </div>
    </div>

    <!-- Delete Account Confirmation Modal -->
    <div id="deleteAccountModal" class="modal-overlay" inert aria-hidden="true">
        <div class="modal-content modal-danger" role="dialog" aria-labelledby="deleteModalTitle" aria-modal="true">
            <div class="modal-header">
                <h2 id="deleteModalTitle">Confirm Account Deletion</h2>
                <button class="modal-close" aria-label="Close modal">×</button>
            </div>

            <div class="modal-body">
                <p style="font-weight: 500; color: #d32f2f; margin-bottom: 1rem;">
                    ⚠️ This action is permanent and cannot be undone.
                </p>
                <p>
                    Deleting your account will remove:
                </p>
                <ul style="margin: 1rem 0; padding-left: 1.5rem;">
                    <li>Your profile and personal information</li>
                    <li>Your wellness goals and preferences</li>
                    <li>Your project history</li>
                    <li>All connections with practitioners</li>
                </ul>
                <p style="margin-top: 1rem;">
                    Type <strong>"DELETE"</strong> below to confirm:
                </p>
                <input type="text" id="deleteConfirmInput" placeholder="Type DELETE to confirm" class="form-control" style="margin: 1rem 0; padding: 0.75rem; border: 1px solid #ccc; border-radius: 4px; width: 100%; font-family: monospace;">
            </div>

            <div class="form-actions full-width">
                <button type="button" class="btn btn-secondary modal-cancel">Cancel</button>
                <button type="button" id="confirmDeleteBtn" class="btn btn-danger" disabled>
                    Permanently Delete Account
                </button>
            </div>
        </div>
    </div>

    <!-- Toast Notification -->
    <div id="toast" class="toast" role="status" aria-live="polite"></div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script src="../scripts/config.js"></script>
    <script src="../scripts/authManager.js"></script>
    <script src="../scripts/authModal.js"></script>
    <script src="../scripts/authHooks.js"></script>
    <script src="../injections.js"></script>
    <script src="../scripts/dashboard-client.js"></script>
</body>
</html>
