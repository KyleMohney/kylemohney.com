<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>My Profile | Rooted Vitality</title>
  <meta name="description" content="Your professional practitioner profile on Rooted Vitality.">
  
  <link rel="stylesheet" href="/styles/styles.css">
  <link rel="stylesheet" href="/styles/profile.css">
</head>
<body class="pro-dashboard">
  <script>
    localStorage.setItem('active_view', 'practitioner');
  </script>
  
  <header id="header-inject"></header>

  <main id="profile-container" class="profile-main">
    <article class="profile-page">
      
      <!-- Profile Header Card -->
      <div class="profile-header-card">
        <div class="profile-avatar-container">
          <img id="profile-avatar" src="/assets/default-avatar.png" alt="Your profile" class="profile-avatar">
          <label class="avatar-upload-btn" title="Change profile photo">
            <input type="file" id="avatar-input" accept="image/*" style="display: none;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
              <circle cx="12" cy="13" r="4"></circle>
            </svg>
          </label>
        </div>
        
        <div class="profile-header-info">
          <input type="text" id="profile-name" class="profile-name-input" placeholder="Your Full Name" value="">
          
          <div class="profile-meta-inputs">
            <div class="meta-field">
              <label>Location</label>
              <input type="text" id="profile-location" placeholder="e.g., Denver, Colorado" value="">
            </div>
            <div class="meta-field">
              <label>Years in Service</label>
              <input type="number" id="profile-years" placeholder="e.g., 8" min="0" value="">
            </div>
            <div class="meta-field">
              <label>Team Size</label>
              <input type="text" id="profile-teamsize" placeholder="e.g., 1–10" value="">
            </div>
          </div>
        </div>
      </div>

      <!-- Profile Completeness Section -->
      <div class="profile-completeness-section">
        <!-- Profile Completeness Meter -->
        <div class="profile-completeness-card">
          <div class="completeness-content">
            <div class="completeness-text">
              <div class="completeness-header">
                <h3>Profile Completeness</h3>
              </div>
              <p id="completeness-percentage">0%</p>
            </div>
            <div class="completeness-bar-container">
              <div class="completeness-bar">
                <div id="completeness-progress" class="completeness-progress" style="width: 0%;"></div>
              </div>
              <p class="completeness-label" id="completeness-label">Fill in sections to complete your profile</p>
            </div>
          </div>

          <!-- Profile Completeness Info Card -->
          <div class="completeness-tooltip-content">
            <p><strong>Complete profiles are:</strong></p>
            <ul>
              <li>3x more likely to be selected by clients</li>
              <li>Featured higher in search results</li>
              <li>More trusted with verified credentials</li>
              <li>Receive more qualified leads</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Quick Stats Dashboard -->
      <div class="quick-stats-dashboard">
        <div class="stat-item" title="Your verification status with our platform">
          <div class="stat-icon stat-icon-check"></div>
          <div class="stat-content">
            <div class="stat-label">Verified Status</div>
            <div id="stat-verified" class="stat-value">Pending</div>
          </div>
        </div>
        <div class="stat-item" title="Preview your public profile as clients see it">
          <div class="stat-icon stat-icon-user"></div>
          <div class="stat-content">
            <div class="stat-label">Profile Preview</div>
            <a href="#" id="view-public-profile" class="stat-link">View Public Profile</a>
          </div>
        </div>
      </div>

      <!-- Profile Sections Container -->
      <div class="profile-sections-wrapper">

        <!-- About Section -->
        <section class="profile-section" data-section="about">
          <div class="section-header">
            <h2>About</h2>
            <button class="section-save-btn" data-section="about">Save</button>
            <button class="section-edit-btn" data-section="about" style="display: none;">Edit</button>
          </div>
          <div class="section-tooltip">Share your background, experience, and what makes your approach unique. Be personal and welcoming.</div>
          <textarea id="about-content" class="profile-textarea section-edit-field" data-section="about" placeholder="Tell us about yourself, your background, and your wellness philosophy..."></textarea>
          <div id="about-display" class="section-display-text" style="display: none;"></div>
        </section>

        <!-- Approach & Philosophy Section -->
        <section class="profile-section" data-section="approach">
          <div class="section-header">
            <h2>Approach & Philosophy</h2>
            <button class="section-save-btn" data-section="approach">Save</button>
            <button class="section-edit-btn" data-section="approach" style="display: none;">Edit</button>
          </div>
          <div class="section-tooltip">Explain your treatment philosophy and methodology. What principles guide your practice?</div>
          <textarea id="approach-content" class="profile-textarea section-edit-field" data-section="approach" placeholder="Describe your treatment approach and core wellness philosophy..."></textarea>
          <div id="approach-display" class="section-display-text" style="display: none;"></div>
        </section>

        <!-- Degrees Section -->
        <section class="profile-section" data-section="degrees">
          <div class="section-header">
            <h2>Degrees & Education</h2>
            <button class="section-save-btn" data-section="degrees">Save</button>
          </div>
          <div class="section-tooltip">List your formal education, degrees, and academic credentials that qualify you as a practitioner.</div>
          <div class="credentials-section-edit" id="degrees-edit" style="display: none;">
            <div id="degrees-list" class="credentials-list"></div>
            <button class="btn-add-credential" id="add-degree-btn" data-credential-type="degree">+ Add Degree</button>
          </div>
          <div class="credentials-section-display" id="degrees-display"></div>
        </section>

        <!-- Licenses Section -->
        <section class="profile-section" data-section="licenses">
          <div class="section-header">
            <h2>Licenses</h2>
            <button class="section-save-btn" data-section="licenses">Save</button>
          </div>
          <div class="section-tooltip">Add your professional licenses, their issuing authority, and license numbers for credibility.</div>
          <div class="credentials-section-edit" id="licenses-edit" style="display: none;">
            <div id="licenses-list" class="credentials-list"></div>
            <button class="btn-add-credential" id="add-license-btn" data-credential-type="license">+ Add License</button>
          </div>
          <div class="credentials-section-display" id="licenses-display"></div>
        </section>

        <!-- Certifications Section -->
        <section class="profile-section" data-section="certifications">
          <div class="section-header">
            <h2>Certifications</h2>
            <button class="section-save-btn" data-section="certifications">Save</button>
          </div>
          <div class="section-tooltip">Include relevant professional certifications that validate your expertise and training.</div>
          <div class="credentials-section-edit" id="certifications-edit" style="display: none;">
            <div id="certifications-list" class="credentials-list"></div>
            <button class="btn-add-credential" id="add-certification-btn" data-credential-type="certification">+ Add Certification</button>
          </div>
          <div class="credentials-section-display" id="certifications-display"></div>
        </section>

        <!-- Photo Albums Section -->
        <section class="profile-section">
          <div class="section-header-with-btn">
            <h2>Photo Albums</h2>
            <button class="btn-secondary" id="add-album-btn">+ Add Album</button>
          </div>
          <div id="albums-container" class="albums-container">
            <p class="placeholder-text">No photo albums yet. Click "Add Album" to get started.</p>
          </div>
        </section>

        <!-- Social Media Section -->
        <section class="profile-section" data-section="social">
          <div class="section-header">
            <h2>Social Media & Connect</h2>
            <button class="section-save-btn" data-section="social">Save</button>
          </div>
          <div class="section-tooltip">Add links to your professional social profiles to build trust and expand your reach.</div>
          <div class="social-inputs-grid">
            <div class="social-input-field">
              <label for="social-facebook">Facebook</label>
              <input type="url" id="social-facebook" class="section-edit-field" data-section="social" placeholder="https://facebook.com/yourprofile" value="">
            </div>
            <div class="social-input-field">
              <label for="social-instagram">Instagram</label>
              <input type="url" id="social-instagram" class="section-edit-field" data-section="social" placeholder="https://instagram.com/yourprofile" value="">
            </div>
            <div class="social-input-field">
              <label for="social-x">X (Twitter)</label>
              <input type="url" id="social-x" class="section-edit-field" data-section="social" placeholder="https://x.com/yourprofile" value="">
            </div>
            <div class="social-input-field">
              <label for="social-linkedin">LinkedIn</label>
              <input type="url" id="social-linkedin" class="section-edit-field" data-section="social" placeholder="https://linkedin.com/in/yourprofile" value="">
            </div>
            <div class="social-input-field">
              <label for="social-youtube">YouTube</label>
              <input type="url" id="social-youtube" class="section-edit-field" data-section="social" placeholder="https://youtube.com/@yourprofile" value="">
            </div>
            <div class="social-input-field">
              <label for="social-tiktok">TikTok</label>
              <input type="url" id="social-tiktok" class="section-edit-field" data-section="social" placeholder="https://tiktok.com/@yourprofile" value="">
            </div>
            <div class="social-input-field">
              <label for="social-pinterest">Pinterest</label>
              <input type="url" id="social-pinterest" class="section-edit-field" data-section="social" placeholder="https://pinterest.com/yourprofile" value="">
            </div>
            <div class="social-input-field">
              <label for="social-website">Your Website</label>
              <input type="url" id="social-website" class="section-edit-field" data-section="social" placeholder="https://yourwebsite.com" value="">
            </div>
          </div>
        </section>

        <!-- Languages Section -->
        <section class="profile-section" data-section="languages">
          <div class="section-header">
            <h2>Languages</h2>
            <button class="section-save-btn" data-section="languages">Save</button>
          </div>
          <div class="section-tooltip">Add all languages you speak professionally. Type a language name and press Enter to add it.</div>
          <div class="languages-input-container">
            <input 
              type="text" 
              id="language-input" 
              class="language-text-input" 
              placeholder="Type a language (e.g., English, Spanish, Mandarin) and press Enter"
              data-section="languages"
            >
            <div id="languages-list" class="languages-list"></div>
          </div>
        </section>

        <!-- FAQ Section -->
        <section class="profile-section" data-section="faq">
          <div class="section-header">
            <h2>Frequently Asked Questions</h2>
            <button class="section-save-btn" data-section="faq">Save</button>
          </div>
          <div class="section-tooltip">Answer common questions clients ask. This helps build trust and sets expectations.</div>
          <div id="faq-list" class="faq-list"></div>
          <button class="btn-add-credential" id="add-faq-btn">+ Add Question</button>
        </section>

        <!-- Background Check Section -->
        <section class="profile-section profile-final">
          <h2>Background Check & Verification</h2>
          <div class="background-check-container">
            <div class="background-check-info">
              <p class="background-check-description">
                A background check is required to verify your credentials and build trust with potential clients. 
                This is a secure, one-time verification process.
              </p>
              <div id="background-check-status" class="background-check-status-placeholder"></div>
            </div>
            <button class="btn-accent" id="start-background-check">Start Background Check</button>
          </div>
        </section>

      </div>

      <!-- Save Status -->
      <div class="save-status" id="save-status"></div>

    </article>
  </main>

  <!-- Profile Picture Upload Modal -->
  <div id="profile-picture-modal" class="modal" style="display: none;">
    <div class="modal-overlay" onclick="closeProfilePictureModal()"></div>
    <div class="modal-content profile-picture-modal">
      <div class="modal-header">
        <h2>Upload Profile Picture</h2>
        <button class="modal-close-btn" onclick="closeProfilePictureModal()">×</button>
      </div>

      <div class="modal-body">
        <!-- Drop Zone -->
        <div id="upload-dropzone" class="upload-dropzone">
          <div class="dropzone-icon">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="17 8 12 3 7 8"></polyline>
              <line x1="12" y1="3" x2="12" y2="15"></line>
            </svg>
          </div>
          <h3>Drag and drop your photo here</h3>
          <p>or</p>
          <button class="browse-btn" onclick="document.getElementById('profile-picture-input').click()">Browse Files</button>
          <input type="file" id="profile-picture-input" accept="image/jpeg,image/png,image/webp" style="display: none;">
          <p class="dropzone-note">JPG, PNG or WebP • Max 5MB</p>
        </div>

        <!-- Preview Section -->
        <div id="preview-section" class="preview-section" style="display: none;">
          <div class="preview-image-container">
            <img id="preview-image" src="" alt="Preview" class="preview-image">
          </div>
          <div class="preview-info">
            <p id="preview-filename"></p>
            <p id="preview-size"></p>
          </div>
        </div>

        <!-- Upload Progress -->
        <div id="upload-progress-section" class="upload-progress-section" style="display: none;">
          <p>Uploading...</p>
          <div class="progress-bar">
            <div id="progress-fill" class="progress-fill"></div>
          </div>
          <p id="progress-percentage">0%</p>
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn-secondary" onclick="closeProfilePictureModal()">Cancel</button>
        <button id="confirm-upload-btn" class="btn-primary" onclick="confirmProfilePictureUpload()" style="display: none;">Upload Photo</button>
      </div>
    </div>
  </div>

  <footer id="footer-inject"></footer>

  <!-- Supabase JS Client Library -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  
  <!-- Rooted Vitality Scripts -->
  <script src="/scripts/config.js"></script>
  <script src="/scripts/authManager.js"></script>
  <script src="/scripts/authModal.js"></script>
  <script src="/scripts/authHooks.js"></script>
  <script src="/injections.js"></script>
  <script src="/scripts/proDashboard.js"></script>
  <script src="/scripts/proProfile.js"></script>
</body>
</html>
